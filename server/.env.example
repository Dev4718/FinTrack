# Server Port
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String
# For Local Postgres: postgresql://<user>:<password>@localhost:5432/fintrack_db?schema=public
# For Supabase / Neon Cloud: postgresql://[user]:[password]@[host]/[dbname]?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fintrack_db?schema=public"

# JWT Authentication
JWT_SECRET="fintrack-production-jwt-secret-key-change-in-prod"
JWT_EXPIRES_IN="7d"

# Frontend Origin for CORS
CLIENT_URL="http://localhost:5173"
